DATABASE_URL="file:./dev.db"

# NextAuth
AUTH_SECRET="generate-a-random-secret-here"
AUTH_URL="http://localhost:3000"

# Admin credentials (used by seed)
ADMIN_EMAIL="admin@sakura.global"
ADMIN_PASSWORD="sakura-admin"

# Storage: "local" or "r2"
STORAGE_ADAPTER="local"

# Cloudflare R2 (optional, for production)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Resend (optional, for contact form emails)
RESEND_API_KEY=""
CONTACT_EMAIL="hey@sakura.global"

# Database (Postgres)
# Local Docker: docker compose up -d
# Neon/Vercel: use the pooled connection string for DATABASE_URL
# and the non-pooled (direct) string for DIRECT_URL / migrations.
DATABASE_URL="postgresql://sakura:sakura@localhost:5432/sakura?schema=public"
DIRECT_URL="postgresql://sakura:sakura@localhost:5432/sakura?schema=public"

# Public site URL (used for metadata / sitemap / OG)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# NextAuth — AUTH_SECRET is REQUIRED on Vercel (without it /api/auth/* = 500)
# Generate: openssl rand -base64 32
AUTH_SECRET="generate-a-random-secret-here"
AUTH_URL="http://localhost:3000"

# Admin credentials (used by prisma db seed)
ADMIN_EMAIL="admin@sakura.global"
ADMIN_PASSWORD="sakura-admin"

# Storage: "local" (dev only) or "r2" (required for uploads on Vercel)
STORAGE_ADAPTER="local"

# Cloudflare R2 (required on Vercel if you use the admin media uploader)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Resend (optional — contact form emails)
RESEND_API_KEY=""
CONTACT_EMAIL="hey@sakura.global"
